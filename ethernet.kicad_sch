				(size 0.85 0.85)
			)
			(justify left bottom)
		)
		(uuid "b90fa1ee-71c4-c1c5-b01b-1698453a91aa")
	)
	(text "AVDD33 x2, DVDD33, DVDD_RG: 100 nF each at the pin"
		(exclude_from_sim no)
		(at 232.41 334.01 0)
		(effects
