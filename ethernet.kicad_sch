				(size 0.85 0.85)
			)
			(justify left bottom)
		)
		(uuid "8f059e79-b980-6f6f-619d-9964fcab016e")
	)
	(text "LED2: 1000M link (active high); strap CFG_LDO1 = 0"
		(exclude_from_sim no)
		(at 55.88 264.16 0)
		(effects
			(font
				(size 0.85 0.85)
			)
