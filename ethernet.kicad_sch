	(text "RGMII, 3.3 V, 125 MHz DDR"
		(exclude_from_sim no)
		(at 80.01 68.58 0)
		(effects
			(font
				(size 1 1)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "08e264f7-6ee3-d229-ca02-5fc474ee6c44")
	)
	(text "AVDD33 x2, DVDD33, DVDD_RG: 100 nF each at the pin"
		(exclude_from_sim no)
		(at 232.41 334.01 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "146c42c7-6fb3-036c-eb43-bfa62af3fed4")
	)
	(text "four SEPARATE centre taps, 100 nF each"
		(exclude_from_sim no)
		(at 194.31 261.62 0)
		(effects
			(font
				(size 0.85 0.85)
			)
			(justify left bottom)
		)
		(uuid "1ecc4231-2b0b-b4e5-04a9-a2c219dd049e")
	)
	(text "Gigabit Ethernet: RTL8211F-CG, RGMII, discrete magnetics"
		(exclude_from_sim no)
		(at 20.32 21.59 0)
		(effects
			(font
				(size 3 3)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "506be941-a9bb-3ee1-7ea0-f7eee29d05cc")
	)
	(text "RXD1 strap: TXDLY = 1 (4.7 k to DVDD_RG)"
		(exclude_from_sim no)
		(at 330.2 303.53 0)
		(effects
			(font
				(size 0.85 0.85)
			)
			(justify left bottom)
		)
		(uuid "518c0551-61fb-2183-e494-d837ad34016e")
	)
	(text "LED1: 100M link (active high); strap CFG_LDO0 = 0"
		(exclude_from_sim no)
		(at 72.39 232.41 0)
		(effects
			(font
				(size 0.85 0.85)
			)
			(justify left bottom)
		)
		(uuid "68abdf05-915c-399f-32f0-8c6b50bd1f9b")
	)
	(text "Bob Smith termination; the jack's shield goes to the same ground. The magnetics are the isolation (IEEE 802.3); this 1 nF / 3 kV 1812 is the designed bridge across it. The board has not been hipot-tested."
		(exclude_from_sim no)
		(at 287.02 278.13 0)
		(effects
			(font
				(size 0.85 0.85)
			)
			(justify left bottom)
		)
		(uuid "81a1c155-703f-3855-f585-ebcc529d23e9")
	)
	(text "25 MHz, 12 pF crystal, 18 pF loads"
		(exclude_from_sim no)
		(at 88.9 267.97 0)
		(effects
			(font
				(size 0.85 0.85)
			)
			(justify left bottom)
		)
		(uuid "871206fd-2011-ec6d-da0f-3432c61932fc")
	)
	(text "switcher output 10 µF X5R, 100 nF per 1.0 V pin"
		(exclude_from_sim no)
		(at 232.41 360.68 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "887355df-80e7-1eee-00f6-94e4d6ba6e73")
	)
	(text "internal 1.0 V switcher output: feeds only this chip; the inductor must take 600 mA (a power inductor, not a chip one)"
		(exclude_from_sim no)
		(at 190.5 294.64 0)
		(effects
			(font
				(size 0.85 0.85)
			)
			(justify left bottom)
		)
		(uuid "888b9066-382f-caf3-9d5d-438d6db55aa3")
	)
	(text "LED0: 10M link (active low); strap CFG_EXT = 1, 3.3 V I/O"
		(exclude_from_sim no)
		(at 90.17 215.9 0)
		(effects
