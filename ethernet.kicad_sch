	(text "MDIO, INTB, RST: 4.7 k up\n(MDIO's 1.5 k is for a long bus)\nRST: 330 Ω + 1 µF, ~10 ms after power"
		(exclude_from_sim no)
		(at 62.23 121.92 0)
		(effects
