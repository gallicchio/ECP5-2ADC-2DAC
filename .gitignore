*_gerbers_Y*.zip
# Cloned reference designs (reference/SOURCES.md records what and when)
/reference/*/

# ---- The bench's record -----------------------------------------------------------------------------------------
/bringup/data/
/bringup/bench_config.json
# the phone's originals of photos/, with their metadata
/bringup/board_photos/

# ---- Working notes exchanged with Claude (the chat log is the record) -------------------------------------------
/QUESTIONS.md
/ANSWERS.md

# ---- Build intermediates, except the small results a reviewer without KiCad needs --------------------------------
/build/*
!/build/netlist.net
!/build/drc.json
!/build/erc.json
!/build/route_report.json
!/build/lcsc.json
!/build/placement.json
!/build/pin_swaps.json
!/build/bus_plan.json
# a reviewer's private copy of the tree, or of the KiCad project to run DRC/ERC on
/design_review/*/repo/
/design_review/*/kicad_copy/
# the gateware pin proof's outputs (gateware/test/build.sh remakes them in every build)
/gateware/test/pins.json
/gateware/test/pins.config
/gateware/test/pins.bit
/gateware/test/pins.pnr.log
# the bring-up gateware's build intermediates (the bitstreams are kept)
/gateware/bringup/build/*
!/gateware/bringup/build/*.bit

