DAC output stage: IOUTA/IOUTB 0..19.2 mA into 24.9 R -> OPA2810 difference amp gain 4 -> 49.9 R -> 50 R load
.include opamps.lib
* complementary current sources: Ia = code/16383 * 19.2 mA, Ib = 19.2 mA - Ia; code swept by the control block
.param ia=9.6m
Ia 0 va {ia}
Ib 0 vb {19.2m - ia}
Ra va 0 24.9
Rb vb 0 24.9
Rgp va ip 499
Rgn vb im 499
Rtp ip 0 2k
X1 ip im vp5 vm5 out OPA2810
Rf out im 2k
Cf out im 2.2p
Vp5 vp5 0 5
Vm5 vm5 0 -4.4
Rs out sma 49.9
Rload sma 0 50
.control
foreach cur 0 4.8m 9.6m 14.4m 19.2m
  alterparam ia = $cur
  reset
  op
  print v(va) v(vb) v(out) v(sma)
end
alterparam ia = 9.6m
reset
* small-signal bandwidth: wiggle Ia
alter Ia ac=1m
ac dec 20 10k 300meg
let g = db(v(out))
meas ac g10k find g at=10k
meas ac f3db when g=g10k-3 fall=1
print g10k f3db
.endc
.end
