			)
			(justify left top)
		)
		(uuid "cee6a684-3258-5383-ae9e-26f575301b16")
	)
	(text_box "Any FPGA clock, 50 Ω source terminated: 3.3 V open circuit, 1.65 V into 50 Ω; the other board's CLK IN squares it up."
		(exclude_from_sim no)
		(at 25.4 248.92 0)
		(size 96.52 5.08)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
