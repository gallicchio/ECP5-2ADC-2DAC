				(size 0.9 0.9)
			)
			(justify left top)
		)
		(uuid "2ffff2a0-4746-422f-880e-589525086651")
	)
	(text_box "Any address or data bit can be swapped for routing: the SDRAM controller does not care which ball is A5. Clocked by an FPGA ODDR at up to 100 MHz, no termination, 3.3 V LVCMOS."
		(exclude_from_sim no)
		(at 560.07 180.34 0)
		(size 147.32 5.08)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
