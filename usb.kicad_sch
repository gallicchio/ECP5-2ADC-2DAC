	(text "DDC I2C level shifted: 3.3 k pull-ups on the FPGA side,\n4.7 k to +5 V on the cable side; EN tied to VREF2 through 200 k\nas the datasheet asks. +5 V to the monitor through a 500 mA polyfuse.\nHPD: the sink pulls it to +5 V, so 4.7 k in series and 10 k down\nput 3.2 V on the FPGA pin (the ECP5's limit is 3.6 V)."
		(exclude_from_sim no)
		(at 308.61 147.32 0)
		(effects
			(font
				(size 0.85 0.85)
			)
			(justify left top)
		)
		(uuid "9b8987a9-7504-fff8-7238-a972df18f264")
	)
