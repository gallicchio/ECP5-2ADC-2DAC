	(gr_text "(10 MHz reference or external clock into the FPGA PLL), CLK OUT.  Gigabit"
		(at 115.025 46.675 0)
		(layer "B.SilkS")
		(uuid "04799126-e7e2-42b1-8350-2b27512d5ae3")
		(effects
			(font
				(size 1 1)
				(thickness 0.16)
			)
			(justify left mirror)
		)
	)
	(gr_text "Ethernet, two USB-C (PROG: power, programming, UART; USER: the FPGA's own"
		(at 115.025 48.975 0)
		(layer "B.SilkS")
		(uuid "90d329b9-38e0-489a-873b-14c5e6f02355")
		(effects
			(font
				(size 1 1)
				(thickness 0.16)
			)
			(justify left mirror)
		)
	)
	(gr_text "DAC to 125 MS/s (±1 V into 50 Ω, ±2 V open); channel 1 also drives an LED."
		(at 116.025 42.075 0)
		(layer "B.SilkS")
		(uuid "9a86a701-e9f9-4683-8630-6b73385ba5f8")
		(effects
			(font
				(size 1 1)
				(thickness 0.16)
			)
			(justify left mirror)
		)
	)
	(gr_text "ECP5 LFE5U-25F FPGA, 32 MB SDRAM, 16 MB flash, microSD.  AD9238 dual 12-bit"
		(at 117.025 37.475 0)
		(layer "B.SilkS")
		(uuid "0d4a6149-a8f8-4484-8969-8ad42e939925")
		(effects
			(font
				(size 1 1)
				(thickness 0.16)
			)
			(justify left mirror)
		)
	)
	(gr_text "USB), mini HDMI, two Pmods.  Power 5 V in by USB PROG or the 5 V IN header."
		(at 117.025 51.275 0)
		(layer "B.SilkS")
		(uuid "c5bae0d0-2300-4313-8fa2-34ae417530ba")
		(effects
			(font
				(size 1 1)
				(thickness 0.16)
			)
			(justify left mirror)
		)
	)
	(gr_text "ADC to 65 MS/s (±1 V, 50 Ω or hi-Z, gain x1 / x10 / x100).  AD9767 dual 14-bit"
