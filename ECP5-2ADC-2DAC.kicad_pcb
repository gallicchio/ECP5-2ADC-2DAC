	)
	(gr_text "Si5351 clock generator, CLK IN (10 MHz reference or external clock into the FPGA PLL), CLK OUT.  Gigabit Ethernet, two USB-C"
		(at 136.3 40.05 0)
		(layer "B.SilkS")
		(uuid "71f196b6-d244-42a7-8017-f60b4064fafa")
		(effects
			(font
				(size 0.9 0.9)
				(thickness 0.16)
			)
			(justify left mirror)
		)
	)
	(gr_text "(PROG: power, programming, UART; FPGA: the FPGA's own USB), mini HDMI, two Pmods.  Power 5 V in by USB PROG or the 5 V IN header."
		(at 140.8 42.15 0)
		(layer "B.SilkS")
		(uuid "4340e614-c089-4742-81f6-0814cc5b2c94")
		(effects
			(font
				(size 0.9 0.9)
				(thickness 0.16)
			)
			(justify left mirror)
		)
	)
	(gr_text "ECP5 LFE5U-25F FPGA, 32 MB SDRAM, 16 MB flash, microSD.  AD9238 dual 12-bit ADC to 65 MS/s (±1 V, 50 Ω or hi-Z, gain x1/x10/x100)."
		(at 141.7 35.85 0)
		(layer "B.SilkS")
		(uuid "e059ad6f-27aa-428e-8b79-58773b73911d")
		(effects
			(font
				(size 0.9 0.9)
				(thickness 0.16)
			)
			(justify left mirror)
		)
	)
	(gr_text "AD9767 dual 14-bit DAC to 125 MS/s (±1 V into 50 Ω); channel 2 also drives an LED.  Noise source, photodiode receiver, 25 MHz TCXO,"
		(at 142.6 37.95 0)
		(layer "B.SilkS")
		(uuid "b4368c4d-d9a8-47bc-809b-feb2f140d921")
		(effects
			(font
				(size 0.9 0.9)
				(thickness 0.16)
			)
			(justify left mirror)
		)
	)
