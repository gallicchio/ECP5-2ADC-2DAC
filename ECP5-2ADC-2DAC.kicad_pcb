			)
			(justify left mirror)
		)
	)
	(gr_text "Si5351 clock generator, CLK IN (10 MHz reference or external clock into the FPGA PLL), CLK OUT.  Gigabit Ethernet, two USB-C"
		(at 136.4 37.55 0)
		(layer "B.SilkS")
		(uuid "f91d5b6b-b9ba-4231-8c81-6aabc8e8b85d")
		(effects
			(font
				(size 0.9 0.9)
				(thickness 0.16)
			)
			(justify left mirror)
		)
	)
	(gr_text "(PROG: power, programming, UART; FPGA: the FPGA's own USB), mini HDMI, two Pmods.  Power 5 V in by USB PROG or the 5 V IN header."
		(at 140.9 39.65 0)
		(layer "B.SilkS")
		(uuid "81ad1e49-9c32-4bd4-8741-189d583c9921")
		(effects
			(font
				(size 0.9 0.9)
				(thickness 0.16)
			)
			(justify left mirror)
		)
	)
	(gr_text "ECP5 LFE5U-25F FPGA, 32 MB SDRAM, 16 MB flash, microSD.  AD9238 dual 12-bit ADC to 65 MS/s (±1 V, 50 Ω or hi-Z, gain x1/x10/x100)."
		(at 141.8 33.35 0)
		(layer "B.SilkS")
		(uuid "6089efab-2844-4b09-8938-cfd621d0edae")
		(effects
			(font
				(size 0.9 0.9)
				(thickness 0.16)
			)
			(justify left mirror)
		)
	)
	(gr_text "AD9767 dual 14-bit DAC to 125 MS/s (±0.9 V into 50 Ω); channel 2 also drives an LED.  Noise source, photodiode receiver, 25 MHz TCXO,"
		(at 144.5 35.45 0)
		(layer "B.SilkS")
		(uuid "43e20580-1316-445b-8ed9-20961ebb5e97")
		(effects
			(font
				(size 0.9 0.9)
				(thickness 0.16)
			)
			(justify left mirror)
		)
	)
